{
  "name": "archery-timer",
  "version": "1.0.0",
  "description": "射箭比赛计时系统 - 一个专业的射箭比赛计时和控制系统",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "backend:build": "cd backend && mvn clean package -DskipTests",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "start": "concurrently \"npm run dev\" \"npm run electron-dev\"",
    "build:all": "npm run backend:build && npm run frontend:build",
    "dist": "npm run build:all && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.1.0",
    "@stomp/stompjs": "^7.0.0",
    "element-plus": "^2.4.1",
    "howler": "^2.2.4",
    "sockjs-client": "^1.6.1",
    "vue": "^3.3.4",
    "vue-router": "^4.2.5",
    "mime": "^4.1.0",
    "electron-is-dev": "^3.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.4.0",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "^4.4.11"
  },
  "build": {
    "appId": "com.archery.timer",
    "productName": "射箭比赛计时系统",
    "files": [
      "dist",
      "backend/target/archery-timer-*.jar",
      "electron/main.js",
      "electron/preload.js",
      "electron/log.html",
      "jre/**/*",
      "node_modules/**/*"
    ],
    "extraMetadata": {
      "name": "archery-timer"
    },
    "asarUnpack": [
      "node_modules/app-builder-bin/**/*",
      "node_modules/electron-winstaller/**/*",
      "node_modules/7zip-bin/**/*",
      "node_modules/@types/**/*",
      "node_modules/@babel/**/*",
      "node_modules/@esbuild/**/*",
      "node_modules/@electron/rebuild/**/*",
      "node_modules/app-builder-lib/**/*",
      "node_modules/builder-util/**/*",
      "node_modules/builder-util-runtime/**/*",
      "node_modules/dmg-license/**/*",
      "node_modules/isbinaryfile/**/*",
      "node_modules/fs-extra/**/*",
      "node_modules/glob/**/*",
      "node_modules/is-ci/**/*",
      "node_modules/node-gyp/**/*",
      "node_modules/postject/**/*",
      "node_modules/tar/**/*",
      "node_modules/ts-node/**/*",
      "node_modules/typescript/**/*",
      "node_modules/vite/**/*",
      "node_modules/electron-builder/**/*",
      "node_modules/rollup/**/*",
      "node_modules/@vitejs/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/target/archery-timer-1.0.0.jar",
        "to": "archery-timer-1.0.0.jar"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "jre",
        "to": "jre"
      }
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  }
}
