{
  "name": "archery-timer",
  "version": "1.0.0",
  "description": "射箭比赛计时系统 - 一个专业的射箭比赛计时和控制系统",
  "author": {
    "name": "射箭计时系统团队",
    "email": "support@archery-timer.com"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "frontend:build": "cd frontend && npm install && npm run build",
    "backend:build": "cd backend && mvn clean package -DskipTests",
    "electron": "electron .",
    "dist:win": "npm run backend:build && npm run frontend:build && electron-builder --win"
  },
  "dependencies": {
    "mime": "^3.0.0"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "electron": "33.3.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.archery.timer",
    "publish": null,
    "productName": "射箭比赛计时系统",
    "icon": "./icon.ico",
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "backend/target/archery-timer-backend-1.0.0.jar",
        "to": "archery-timer.jar"
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "jre",
        "to": "jre",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName} Setup ${version}.${ext}",
      "icon": "./icon.ico",
      "signAndEditExecutable": false,
      "signDlls": false,
      "signingHashAlgorithms": null,
      "certificateSubjectName": null,
      "certificateSha1": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "射箭比赛计时系统",
      "unicode": true,
      "installerIcon": "./icon.ico",
      "uninstallerIcon": "./icon.ico"
    }
  }
}
